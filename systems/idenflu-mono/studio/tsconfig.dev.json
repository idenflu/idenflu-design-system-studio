{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "paths": {
      "@idenflu/mono-react": ["src/index.ts"],
      "@idenflu/mono-react/icons": ["src/icons/index.ts"],
      "@idenflu/mono-react/package.json": ["package.json"],
      "react": ["node_modules/@types/react"],
      "react/*": ["node_modules/@types/react/*"],
      "react-dom": ["node_modules/@types/react-dom"],
      "react-dom/*": ["node_modules/@types/react-dom/*"]
    }
  }
}
