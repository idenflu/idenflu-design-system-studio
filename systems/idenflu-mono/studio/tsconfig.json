{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "lib": [
      "ES2020",
      "DOM",
      "DOM.Iterable"
    ],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "baseUrl": "../../../packages/idenflu-mono-react",
    "paths": {
      "@idenflu/mono-react": [
        "dist/index.d.ts"
      ],
      "@idenflu/mono-react/icons": [
        "dist/icons/index.d.ts"
      ],
      "react": [
        "node_modules/@types/react"
      ],
      "react/*": [
        "node_modules/@types/react/*"
      ],
      "react-dom": [
        "node_modules/@types/react-dom"
      ],
      "react-dom/*": [
        "node_modules/@types/react-dom/*"
      ],
      "@idenflu/mono-react/package.json": [
        "package.json"
      ]
    },
    "typeRoots": [
      "../../../packages/idenflu-mono-react/node_modules/@types"
    ]
  },
  "include": [
    "./app.tsx",
    "./dist/*.json",
    "./examples/app.tsx"
  ]
}
