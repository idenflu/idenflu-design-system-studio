{
  "extends": "../../../packages/mono-react/tsconfig.json",
  "compilerOptions": {
    "resolveJsonModule": true,
    "baseUrl": "../../../packages/mono-react",
    "paths": {
      "@idenflu/mono-react": ["dist/index.d.ts"],
      "@idenflu/mono-react/icons": ["dist/icons/index.d.ts"],
